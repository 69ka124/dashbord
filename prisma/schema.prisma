generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Invite by email: user signs in with this address (no password).
model AccessGrant {
  id        String    @id @default(cuid())
  email     String
  role      String
  label     String?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([email])
  @@index([email])
}

model WorkType {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  works     Work[]
}

model Counterparty {
  id            String             @id @default(cuid())
  code          String?
  name          String
  shortTabName  String?
  recipientType String?
  tabName       String?
  legalName     String?
  inn           String?
  mainCategory  String?
  contractFolder String?
  responsible   String?
  limitControl  String?
  separateTab   Boolean            @default(false)
  status        String             @default("активен")
  comment       String?
  contact       String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  works         Work[]
  payments      Payment[]
  limits        CounterpartyLimit[]
  expenseRecords ExpenseRecord[]

  @@index([name])
  @@index([code])
  @@index([status])
}

model CounterpartyLimit {
  id             String       @id @default(cuid())
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Cascade)
  year           Int
  annualLimit    Decimal
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([counterpartyId, year])
  @@index([year])
}

model Work {
  id             String        @id @default(cuid())
  title          String
  amount         Decimal
  status         String        @default("planned")
  dueDate        DateTime?
  comment        String?
  workTypeId     String
  workType       WorkType      @relation(fields: [workTypeId], references: [id])
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([workTypeId])
  @@index([counterpartyId])
  @@index([dueDate])
}

model Payment {
  id             String        @id @default(cuid())
  type           String
  amount         Decimal
  date           DateTime
  comment        String?
  workId         String?
  work           Work?         @relation(fields: [workId], references: [id], onDelete: SetNull)
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([date])
  @@index([workId])
  @@index([type])
}

model ProductionOrder {
  id         String    @id @default(cuid())
  orderCode  String
  jiraUrl    String?
  receivedAt DateTime
  project    String
  client     String
  workType   String
  ke         String?
  status     String    @default("в работе")
  income     Decimal   @default(0)
  deadline   DateTime?
  estimate   Decimal?
  materials  String?
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([receivedAt])
  @@index([deadline])
  @@index([status])
  @@index([workType])
  @@index([client])
}

model DesignOrder {
  id         String    @id @default(cuid())
  orderCode  String
  jiraUrl    String?
  receivedAt DateTime
  project    String
  client     String
  ke         String?
  status     String    @default("в работе")
  income     Decimal   @default(0)
  deadline   DateTime?
  materials  String?
  comment    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([receivedAt])
  @@index([deadline])
  @@index([status])
  @@index([client])
}

model IncomeRecord {
  id           String   @id @default(cuid())
  incomeCode   String   @unique
  receivedAt   DateTime
  incomeKind   String
  payer        String
  project      String
  amount       Decimal  @default(0)
  status       String   @default("план")
  documents    String?
  source       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([receivedAt])
  @@index([status])
  @@index([incomeKind])
  @@index([payer])
}

model ExpenseRecord {
  id                String    @id @default(cuid())
  expenseCode       String    @unique
  recipient         String
  task              String
  project           String
  category          String
  registeredAt      DateTime
  workStatus        String    @default("в работе")
  paymentStatus     String    @default("не оплачено")
  amount            Decimal   @default(0)
  totalToPay        Decimal   @default(0)
  plannedPayQuarter Int?
  paidAt            DateTime?
  dueDate           DateTime?
  counterpartyId    String?
  counterparty      Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  orderModule       String?
  client            String?
  ke                String?
  estimate          Decimal?
  orderIncome       Decimal?
  materials         String?
  jiraUrl           String?
  materialUrl       String?
  documents         String?
  comment           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([registeredAt])
  @@index([paidAt])
  @@index([dueDate])
  @@index([counterpartyId])
  @@index([workStatus])
  @@index([paymentStatus])
  @@index([category])
  @@index([recipient])
  @@index([orderModule])
}

model Employee {
  id        String          @id @default(cuid())
  fullName  String
  role      String
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  leaves    VacationLeave[]

  @@index([fullName])
  @@index([role])
}

model VacationLeave {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate     DateTime
  endDate       DateTime
  calendarDays  Int
  workingDays   Int
  leaveType     String   @default("Основной отпуск")
  status        String   @default("План")
  substitute    String?
  comment       String?
  control       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([employeeId])
}

model PurchaseItem {
  id           String    @id @default(cuid())
  type         String
  title        String
  comment      String?
  paymentDate  DateTime?
  unitPrice    Decimal   @default(0)
  quantity     Float     @default(1)
  productUrl   String?
  subscription String?
  lineTotal    Decimal   @default(0)
  priority     String    @default("средний")
  status       String    @default("план")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([paymentDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userLabel String
  tab       String
  entityId  String
  field     String
  oldValue  String?
  newValue  String?
  comment   String?

  @@index([createdAt])
  @@index([tab])
  @@index([userLabel])
  @@index([entityId])
}

model GoogleSyncConfig {
  id                String    @id @default("default")
  spreadsheetId     String?
  spreadsheetUrl    String?
  googleEmail       String?
  refreshToken      String?
  accessToken       String?
  tokenExpiresAt    DateTime?
  oauthClientId     String?
  oauthClientSecret String?
  lastPullAt        DateTime?
  lastPushAt        DateTime?
  lastError         String?
  updatedAt         DateTime  @updatedAt
}

model GoogleSheetSnapshot {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  spreadsheetId  String
  spreadsheetUrl String?
  source         String
  sheetCount     Int      @default(0)
  rowCount       Int      @default(0)
  extraSheets    String?
  fileName       String?
  payload        String

  @@index([createdAt])
  @@index([spreadsheetId])
}

