# Local SQLite (default — works without Docker):
DATABASE_URL="file:./dev.db"

# Cloud Neon Postgres (for Vercel):
# 1) Create free DB at https://neon.tech
# 2) Set DATABASE_URL below
# 3) In prisma/schema.prisma set: provider = "postgresql"
# 4) Run: npx prisma db push
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

AUTH_SECRET="replace-with-long-random-string"
AUTH_TRUST_HOST=true

# Optional Google OAuth (login + Sheets sync):
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Google Cloud → OAuth client → Authorized redirect URIs:
# {AUTH_URL}/api/auth/callback/google
# {AUTH_URL}/api/google/callback

# Owner email — full access, manages /access
OWNER_EMAIL="owner@example.com"

AUTH_URL="http://localhost:3000"

# true = no login (demo only). Production: false
OPEN_ACCESS="false"
