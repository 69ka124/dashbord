# Local SQLite (default — works without Docker):
DATABASE_URL="file:./dev.db"

AUTH_SECRET="replace-with-long-random-string"
AUTH_TRUST_HOST=true

# Optional Google OAuth (login + Sheets sync on /access):
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Owner email — full access, manages /access
OWNER_EMAIL="owner@example.com"

AUTH_URL="http://localhost:3000"

# true = no login (demo only). Production: false
OPEN_ACCESS="false"
